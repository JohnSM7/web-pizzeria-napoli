---
import '~/styles/global.css';
// Fuentes self-hosted (sin CDN) para máxima compatibilidad con Brave/Shields y privacidad
// Fraunces full incluye los axes opsz + SOFT + wght necesarios para la tipografía líquida
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/caprasimo';
import '@fontsource/caveat/400.css';
import '@fontsource/caveat/700.css';
// Leaflet self-hosted (sin unpkg) para evitar bloqueos de Brave
import 'leaflet/dist/leaflet.css';
import { ClientRouter } from 'astro:transitions';
import { negocio } from '~/data/negocio';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Piccola Napoli · Auténtica pizza napolitana en Madrid',
  description = 'Pizza · Casa · Famiglia. Desde 2010, masa de 72 horas, ingredientes honestos y recetas napolitanas. 4,7★ en Google. Solete Guía Repsol. Cuatro Caminos, Ríos Rosas, López de Hoyos.',
  image = '/images/og-cover.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': 'https://piccolanapoli.es/#restaurant',
  name: negocio.nombre,
  description,
  image: [`${Astro.site}images/hero-pizza.jpg`, `${Astro.site}images/horno-llamas.jpg`],
  logo: `${Astro.site}images/logo.png`,
  url: 'https://piccolanapoli.es',
  telephone: negocio.telefono,
  email: negocio.email,
  priceRange: '€€',
  servesCuisine: ['Italiana', 'Napolitana', 'Pizzería'],
  acceptsReservations: 'True',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: String(negocio.rating),
    reviewCount: String(negocio.reseñas),
    bestRating: '5',
    worstRating: '1',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: negocio.locales[0].direccion,
    addressLocality: negocio.locales[0].ciudad,
    postalCode: negocio.locales[0].cp,
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: negocio.locales[0].lat,
    longitude: negocio.locales[0].lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
      opens: '13:00',
      closes: '23:15',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday', 'Saturday'],
      opens: '13:00',
      closes: '23:30',
    },
  ],
  sameAs: [negocio.instagram, negocio.tiktok, negocio.facebook],
  hasMenu: 'https://piccolanapoli.es/#carta',
  foundingDate: '2010',
};
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF6EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1410" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Piccola Napoli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).href} />

    <!-- Fuentes y Leaflet ahora se importan como módulos npm (self-hosted) en el frontmatter -->

    <!-- JSON-LD Restaurant -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />
  </head>
  <body class="grain antialiased">
    <slot />

    <!-- TODOS los efectos JS en un solo bloque is:inline.
         Si Brave Shields, NoScript u otro bloquean este script, el sitio
         queda 100% visible y funcional gracias a la degradación grácil del CSS. -->
    <script is:inline>
      (function () {
        'use strict';
        document.documentElement.classList.add('js');

        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ===== 1) REVEAL DE ENTRADA =====
        function revealAll() {
          var items = document.querySelectorAll('.scroll-reveal, .scroll-fade, .scroll-scale');
          if (!('IntersectionObserver' in window)) {
            for (var i = 0; i < items.length; i++) items[i].classList.add('in-view');
            return;
          }
          var vh = window.innerHeight;
          for (var j = 0; j < items.length; j++) {
            var r = items[j].getBoundingClientRect();
            if (r.top < vh * 0.95) items[j].classList.add('in-view');
          }
          var io = new IntersectionObserver(function (entries) {
            for (var k = 0; k < entries.length; k++) {
              if (entries[k].isIntersecting) {
                entries[k].target.classList.add('in-view');
                io.unobserve(entries[k].target);
              }
            }
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.01 });
          for (var m = 0; m < items.length; m++) {
            if (!items[m].classList.contains('in-view')) io.observe(items[m]);
          }
        }
        revealAll();
        document.addEventListener('astro:page-load', revealAll);

        // ===== 2) MOOD CROMÁTICO + PARALLAX + ROTATE — UN SOLO scroll handler =====
        var moodSections = Array.prototype.slice.call(document.querySelectorAll('[data-section-mood]'));
        var parallaxEls = Array.prototype.slice.call(document.querySelectorAll('.scroll-parallax-slow'));
        var rotateEls = Array.prototype.slice.call(document.querySelectorAll('.scroll-rotate'));
        var lastMood = null;
        var ticking = false;
        var lastScroll = 0;

        function update() {
          var vh = window.innerHeight;
          var midY = lastScroll + vh / 2;

          // MOOD: encontrar la sección cuyo centro está más cerca del centro del viewport
          if (moodSections.length) {
            var bestIdx = -1;
            var bestDist = Infinity;
            for (var i = 0; i < moodSections.length; i++) {
              var sec = moodSections[i];
              var top = sec.offsetTop;
              var h = sec.offsetHeight;
              // Detectar si la sección ocupa el centro del viewport
              if (midY >= top && midY <= top + h) {
                // Estamos dentro de esta sección
                bestIdx = i;
                break;
              }
              var dist = Math.min(Math.abs(midY - top), Math.abs(midY - (top + h)));
              if (dist < bestDist) {
                bestDist = dist;
                bestIdx = i;
              }
            }
            if (bestIdx >= 0) {
              var mood = moodSections[bestIdx].getAttribute('data-section-mood') || '';
              if (mood !== lastMood) {
                document.body.setAttribute('data-mood', mood);
                lastMood = mood;
              }
            }
          }

          if (!reduceMotion) {
            // PARALLAX
            for (var p = 0; p < parallaxEls.length; p++) {
              var el = parallaxEls[p];
              var r = el.getBoundingClientRect();
              if (r.bottom < -200 || r.top > vh + 200) continue;
              var progress = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
              var shift = Math.max(-1, Math.min(1, progress)) * 8;
              el.style.transform = 'translate3d(0,' + shift + '%,0)';
            }
            // ROTATE
            for (var q = 0; q < rotateEls.length; q++) {
              rotateEls[q].style.transform = 'rotate(' + ((lastScroll / 8) % 360) + 'deg)';
            }
          }

          ticking = false;
        }

        function onScroll() {
          lastScroll = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
          if (!ticking) {
            (window.requestAnimationFrame || function (cb) { setTimeout(cb, 16); })(update);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        // Disparo inicial
        update();

        // ===== 3) EFECTO MAGNÉTICO EN CTAs =====
        var supportsHover = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (supportsHover && !reduceMotion) {
          var magnets = document.querySelectorAll('.btn-magnetic');
          for (var n = 0; n < magnets.length; n++) {
            (function (btn) {
              var text = btn.querySelector('.btn-magnetic-text');
              btn.addEventListener('mousemove', function (e) {
                var rr = btn.getBoundingClientRect();
                var x = e.clientX - rr.left;
                var y = e.clientY - rr.top;
                var mx = ((x - rr.width / 2) / rr.width) * 10;
                var my = ((y - rr.height / 2) / rr.height) * 10;
                btn.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0)';
                if (text) text.style.transform = 'translate3d(' + (mx * 1.6) + 'px,' + (my * 1.6) + 'px,0)';
                btn.style.setProperty('--mx', (x / rr.width) * 100 + '%');
                btn.style.setProperty('--my', (y / rr.height) * 100 + '%');
              });
              btn.addEventListener('mouseleave', function () {
                btn.style.transform = '';
                if (text) text.style.transform = '';
              });
            })(magnets[n]);
          }
        }
      })();
    </script>
  </body>
</html>
