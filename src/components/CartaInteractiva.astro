---
import { carta } from '~/data/negocio';

const tabs = [
  { id: 'rosse', label: 'Pizzas Rosse', italiano: 'Tomate San Marzano', items: carta.rosse },
  { id: 'bianche', label: 'Pizzas Bianche', italiano: 'Sin tomate', items: carta.bianche },
  { id: 'pasta', label: 'Pasta', italiano: 'Fatta a mano', items: carta.pasta },
  { id: 'dolci', label: 'Dolci', italiano: 'Hechos en casa', items: carta.dolci },
];
---

<section id="carta" data-section-mood="basilico" class="relative py-20 md:py-32 px-4 sm:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-script text-3xl text-sanmarzano-500 mb-3 scroll-fade">Il menù</p>
      <h2 class="liquid-display text-[clamp(2.5rem,7vw,6rem)] scroll-reveal">
        La carta <span class="liquid-display-italic text-vesubio-500">en italiano y español</span>
      </h2>
      <p class="mt-6 max-w-2xl mx-auto opacity-75 scroll-fade">
        Selección de los favoritos. Hay también opciones <strong>veganas</strong> y <strong>celíacas</strong>. Pregunta a tu camarero.
      </p>
    </div>

    <!-- Tabs -->
    <div class="flex flex-wrap justify-center gap-2 mb-12 scroll-fade" role="tablist">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          data-tab={t.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class={`tab-btn px-5 py-2.5 rounded-full text-sm font-medium border transition ${
            i === 0
              ? 'bg-carbon-900 text-mozzarella border-carbon-900'
              : 'border-carbon-900/20 hover:border-carbon-900'
          }`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <!-- Panels -->
    <div class="relative">
      {tabs.map((t, i) => (
        <div
          role="tabpanel"
          data-panel={t.id}
          class={`tab-panel ${i === 0 ? 'block' : 'hidden'}`}
        >
          <p class="text-center font-script text-2xl text-vesubio-500 mb-8">{t.italiano}</p>
          <div class="grid md:grid-cols-2 gap-x-12 gap-y-2">
            {t.items.map((item) => (
              <div class="group flex items-baseline gap-4 py-4 border-b border-carbon-900/10 hover:border-sanmarzano-500/40 transition">
                <div class="flex-1">
                  <h4 class="accent-display text-xl group-hover:text-sanmarzano-500 transition">{item.n}</h4>
                  <p class="text-sm opacity-70 mt-0.5">{item.d}</p>
                </div>
                <span class="liquid-display text-2xl shrink-0">
                  {item.p}<span class="text-sm opacity-70 ml-0.5">€</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.classList.toggle('bg-carbon-900', active);
        t.classList.toggle('text-mozzarella', active);
        t.classList.toggle('border-carbon-900', active);
        t.classList.toggle('border-carbon-900/20', !active);
      });
      panels.forEach((p) => {
        const show = p.dataset.panel === target;
        p.classList.toggle('hidden', !show);
        p.classList.toggle('block', show);
      });
    });
  });
</script>
