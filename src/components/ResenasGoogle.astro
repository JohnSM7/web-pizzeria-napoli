---
import { negocio, reseñas } from '~/data/negocio';
---

<section id="reseñas" data-section-mood="" class="relative py-32 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto">
    <!-- Header con números -->
    <div class="grid md:grid-cols-12 gap-8 mb-20 items-end">
      <div class="md:col-span-7">
        <p class="font-script text-3xl text-sanmarzano-500 mb-3 scroll-fade">Voci del quartiere</p>
        <h2 class="liquid-display text-[clamp(2.5rem,7vw,6rem)] scroll-reveal">
          La gente del barrio lo dice <span class="liquid-display-italic text-vesubio-500">mejor que nosotros.</span>
        </h2>
      </div>
      <div class="md:col-span-5 grid grid-cols-2 gap-4 scroll-reveal">
        <div class="bento-card !bg-vesubio-500 text-mozzarella p-6 aspect-square flex flex-col justify-between">
          <span class="text-xs uppercase tracking-widest opacity-80">Google</span>
          <div>
            <p class="liquid-display text-7xl leading-none" id="rating-count">{negocio.rating}</p>
            <div class="flex gap-0.5 mt-2 text-cornicione-400">
              {[1,2,3,4,5].map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
          </div>
        </div>
        <div class="bento-card !bg-sanmarzano-500 text-mozzarella p-6 aspect-square flex flex-col justify-between">
          <span class="text-xs uppercase tracking-widest opacity-80">Reseñas</span>
          <div>
            <p class="liquid-display text-5xl leading-none" id="review-count">{negocio.reseñas.toLocaleString('es-ES')}</p>
            <p class="text-xs opacity-80 mt-2">y subiendo cada semana</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tarjetas reseña -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
      {reseñas.map((r, i) => (
        <article
          class="bento-card p-6 flex flex-col gap-4 scroll-reveal !bg-mozzarella-200"
          style={`animation-delay: ${i * 80}ms; transform: rotate(${(i % 2 === 0 ? -1 : 1) * 0.8}deg);`}
        >
          <div class="flex gap-0.5 text-sanmarzano-500">
            {Array.from({ length: r.estrellas }).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <p class="text-[15px] leading-relaxed font-display italic">{r.texto}</p>
          <div class="mt-auto pt-3 border-t border-carbon-900/10">
            <p class="font-semibold text-sm">{r.autor}</p>
            <p class="text-xs opacity-60">{r.fecha}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-12 scroll-fade">
      <a href="https://www.google.com/maps/place/Pizzer%C3%ADa+Piccola+Napoli+%7C+Cuatro+Caminos" target="_blank" rel="noopener" class="btn-ghost">
        Lee las {negocio.reseñas.toLocaleString('es-ES')} reseñas en Google
      </a>
    </div>
  </div>
</section>

<script>
  // Contador animado de rating
  function animateCount(el: HTMLElement, end: number, dec = 0, suffix = '') {
    const dur = 1600;
    const start = performance.now();
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function step(now: number) {
      const t = Math.min((now - start) / dur, 1);
      const v = end * ease(t);
      el.textContent = v.toFixed(dec) + suffix;
      if (t < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          if (el.id === 'rating-count') animateCount(el, 4.7, 1);
          if (el.id === 'review-count') {
            const start = performance.now();
            const ease = (t: number) => 1 - Math.pow(1 - t, 3);
            function step(now: number) {
              const t = Math.min((now - start) / 1800, 1);
              el.textContent = Math.floor(4865 * ease(t)).toLocaleString('es-ES');
              if (t < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          }
          observer.unobserve(el);
        }
      });
    },
    { threshold: 0.6 }
  );
  document.querySelectorAll('#rating-count, #review-count').forEach((el) => observer.observe(el));
</script>
