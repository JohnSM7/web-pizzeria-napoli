---
import { negocio } from '~/data/negocio';
---

<footer data-section-mood="horno" class="relative pt-32 pb-12 px-4 sm:px-8 overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <img src="/images/interior-trattoria.jpg" alt="" class="w-full h-full object-cover opacity-10" loading="lazy" />
  </div>

  <div class="max-w-7xl mx-auto">
    <!-- Banner gigante -->
    <div class="mb-20 scroll-reveal">
      <p class="liquid-display text-[clamp(3rem,11vw,11rem)] leading-[0.85] text-cornicione-500">
        Ti aspettiamo.
      </p>
      <p class="liquid-display-italic text-[clamp(2rem,6vw,5rem)] mt-2">
        Con un horno encendido y la mesa puesta.
      </p>
    </div>

    <div class="grid md:grid-cols-12 gap-12 mb-16">
      <!-- Logo + lema -->
      <div class="md:col-span-4">
        <div class="flex items-center gap-3 mb-4">
          <svg viewBox="0 0 64 48" class="w-10 h-10" fill="none">
            <path d="M4 42 L18 18 L26 30 L36 14 L52 30 L60 42 Z" fill="#0E7A3D"/>
            <rect x="34.5" y="8" width="1.5" height="9" fill="currentColor"/>
            <path d="M36 8 L43 11 L36 14 Z" fill="#C8332A"/>
          </svg>
          <span class="accent-display text-2xl text-vesubio-400">Piccola Napoli</span>
        </div>
        <p class="font-script text-2xl text-sanmarzano-500">Pizza · Casa · Famiglia</p>
        <p class="text-sm opacity-70 mt-4 max-w-xs">
          Desde 2010 servimos auténtica pizza napolitana en Madrid. Familia, tradición y horno de leña.
        </p>
      </div>

      <!-- Navegación -->
      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-widest opacity-50 mb-4">Visita</p>
        <ul class="space-y-2 text-sm">
          <li><a href="#pizzas" class="hover:text-sanmarzano-500 transition">Pizzas estrella</a></li>
          <li><a href="#masa" class="hover:text-sanmarzano-500 transition">La masa</a></li>
          <li><a href="#carta" class="hover:text-sanmarzano-500 transition">Carta completa</a></li>
          <li><a href="#donde" class="hover:text-sanmarzano-500 transition">Nuestros locales</a></li>
          <li><a href={negocio.reservas} target="_blank" rel="noopener" class="hover:text-sanmarzano-500 transition">Reservar mesa →</a></li>
        </ul>
      </div>

      <!-- Pedidos a domicilio -->
      <div class="md:col-span-2">
        <p class="text-xs uppercase tracking-widest opacity-50 mb-4">A casa</p>
        <ul class="space-y-2 text-sm">
          <li><a href={negocio.uberEats} target="_blank" rel="noopener" class="hover:text-sanmarzano-500 transition">Uber Eats</a></li>
          <li><a href={negocio.glovo} target="_blank" rel="noopener" class="hover:text-sanmarzano-500 transition">Glovo</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-widest opacity-50 mb-4">Contacto</p>
        <ul class="space-y-2 text-sm">
          <li><a href={negocio.telefonoLink} class="hover:text-sanmarzano-500 transition">{negocio.telefono}</a></li>
          <li><a href={`mailto:${negocio.email}`} class="hover:text-sanmarzano-500 transition">{negocio.email}</a></li>
        </ul>

        <p class="text-xs uppercase tracking-widest opacity-50 mt-6 mb-3">Síguenos</p>
        <div class="flex gap-2">
          <a href={negocio.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="w-10 h-10 grid place-items-center rounded-full border border-current/20 hover:bg-sanmarzano-500 hover:border-sanmarzano-500 transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37zM17.5 6.5h.01"/></svg>
          </a>
          <a href={negocio.tiktok} target="_blank" rel="noopener" aria-label="TikTok" class="w-10 h-10 grid place-items-center rounded-full border border-current/20 hover:bg-sanmarzano-500 hover:border-sanmarzano-500 transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"/></svg>
          </a>
          <a href={negocio.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="w-10 h-10 grid place-items-center rounded-full border border-current/20 hover:bg-sanmarzano-500 hover:border-sanmarzano-500 transition">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Línea inferior -->
    <div class="pt-8 border-t border-current/10 flex flex-col md:flex-row items-center justify-between gap-4 text-xs">
      <p class="font-script text-base text-cornicione-500 opacity-90">Fatto con amore in Madrid</p>
      <p class="opacity-60">© {new Date().getFullYear()} Piccola Napoli S.L. · Todos los derechos reservados</p>
      <div class="flex gap-4 opacity-60">
        <a href="/aviso-legal" class="hover:opacity-100 transition">Aviso legal</a>
        <a href="/privacidad" class="hover:opacity-100 transition">Privacidad</a>
        <a href="/cookies" class="hover:opacity-100 transition">Cookies</a>
      </div>
    </div>

    <!-- Powered by -->
    <div class="mt-6 pt-6 border-t border-current/5 flex justify-center">
      <a
        href="https://tanesolutions.com"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.25em] opacity-50 hover:opacity-100 transition"
      >
        <span>Powered by</span>
        <span class="accent-display normal-case tracking-normal text-base text-cornicione-500 group-hover:text-sanmarzano-500 transition">
          Tane Solutions
        </span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
